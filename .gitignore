# === Secrets — NEVER committed (rules.md §5) ===
.env
*.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*_cookie*.txt
*_token*.txt

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# === Node / frontend ===
node_modules/
dist/
.vite/
*-debug.log*

# === Data / runtime ===
*.db
*.sqlite*
logs/
*.log
data/
pgdata/
qdrant_storage/

# === Scratch — ignore archive and outputs ===
scratch/archive/
scratch/**/__pycache__/
scratch/**/*.out
# Personal notes/experiments (throwaway per rules.md §3) — keep only the READMEs that document each folder
scratch/**/*.md
!scratch/**/README.md
# Build sources for external deliverables (e.g. the handbook HTML that publishes to an Artifact)
scratch/**/*.html

# === Reports — raw test-run logs stay local; dated phase summaries are committed ===
reports/tests/*/
# Regenerated from .claude/ritual-log by /keel-stats — machine-local telemetry, not an artifact
# (compact-gate already excludes it from its dirty-tree check; this keeps it out of git status).
reports/ritual-stats.md

# === Claude Code — commit settings.json/skills/hooks; ignore personal ===
.claude/settings.local.json
.claude/snapshots/
.claude/ritual-log*
.claude/agent-team-sessions
CLAUDE.local.md

# === Research — commit findings.md; ignore raw/large downloads (rules.md §8) ===
research/**/downloads/
# local/ = notes kept on THIS machine only — working material the owner has not (yet) promoted
# into the tracked findings.md. Same idea as downloads/, for prose instead of files.
research/**/local/

# === OS / editor ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
